#!/usr/bin/env bash
# transcribe-for-agents wrapper: loads saved provider credentials, then runs the
# transcriber-cli.bin engine installed by install.sh. The same file is the
# Claude Code transcription-agent-cli plugin's bin/transcriber-cli, which builds
# the engine on first use when install.sh has not.
set -euo pipefail

# Keep in sync with install.sh; tests/install_test.sh checks that they match.
engine_url='https://github.com/cyanxxy/transcription-agent-go.git'
engine_ref='v1.1.0'
engine_sha='db8313a7ef90a5d20e027328d0cab8d20fc28e8d'

data_dir="${XDG_DATA_HOME:-$HOME/.local/share}/transcribe-for-agents"
config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/transcribe-for-agents"
engine="${TRANSCRIBER_ENGINE_BIN:-$data_dir/transcriber-cli.bin}"
pending_temp=""

fail() { printf 'transcriber-cli: %s\n' "$*" >&2; exit 1; }

valid_provider() {
  case "$1" in gemini|meta|microsoft) ;; *) fail 'provider must be gemini, meta, or microsoft' ;; esac
}

credential_file() {
  case "$1" in
    gemini) printf '%s/gemini.key' "$config_dir" ;;
    meta) printf '%s/meta.key' "$config_dir" ;;
    microsoft) printf '%s/microsoft.key' "$config_dir" ;;
    microsoft-endpoint) printf '%s/microsoft.endpoint' "$config_dir" ;;
  esac
}

env_name() {
  case "$1" in
    gemini) printf 'GEMINI_API_KEY' ;;
    meta) printf 'META_API_KEY' ;;
    microsoft) printf 'AZURE_SPEECH_KEY' ;;
    microsoft-endpoint) printf 'AZURE_SPEECH_ENDPOINT' ;;
  esac
}

check_secret_file() {
  [[ ! -L "$config_dir" ]] || fail "config directory is a symlink: $config_dir"
  [[ ! -L "$1" ]] || fail "credential file is a symlink: $1"
  [[ ! -e "$1" || -f "$1" ]] || fail "credential path is not a regular file: $1"
  if [[ -f "$1" ]]; then
    [[ -O "$1" ]] || fail "credential file is not owned by you: $1"
    chmod 600 "$1"
  fi
}

save_secret() {
  local path="$1" value="$2"
  [[ ! -L "$config_dir" ]] || fail "config directory is a symlink: $config_dir"
  mkdir -p "$config_dir"
  chmod 700 "$config_dir"
  pending_temp="$(mktemp "$config_dir/.credential.XXXXXXXX")"
  chmod 600 "$pending_temp"
  printf '%s' "$value" > "$pending_temp"
  mv -f "$pending_temp" "$path"
  pending_temp=""
}

read_secret() {
  local path="$1"
  check_secret_file "$path"
  if [[ -f "$path" ]]; then cat "$path"; fi
}

# source_of <item>: prints "environment", "local file", or nothing.
source_of() {
  local variable path
  variable="$(env_name "$1")"
  path="$(credential_file "$1")"
  if [[ -n "${!variable:-}" ]]; then
    printf 'environment'
  else
    check_secret_file "$path"
    if [[ -s "$path" ]]; then printf 'local file'; fi
  fi
}

# provider_status <provider>: prints one status line; returns 0 when configured.
provider_status() {
  local key_source endpoint_source
  key_source="$(source_of "$1")"
  if [[ "$1" == microsoft ]]; then
    endpoint_source="$(source_of microsoft-endpoint)"
    if [[ -n "$key_source" && -n "$endpoint_source" ]]; then
      if [[ "$key_source" == "$endpoint_source" ]]; then
        printf 'microsoft: configured via %s\n' "$key_source"
      else
        printf 'microsoft: configured (key via %s, endpoint via %s)\n' "$key_source" "$endpoint_source"
      fi
      return 0
    fi
    if [[ -n "$key_source$endpoint_source" ]]; then
      printf 'microsoft: incomplete (needs both AZURE_SPEECH_KEY and AZURE_SPEECH_ENDPOINT)\n'
    else
      printf 'microsoft: not configured\n'
    fi
    return 1
  fi
  if [[ -n "$key_source" ]]; then
    printf '%s: configured via %s\n' "$1" "$key_source"
    return 0
  fi
  printf '%s: not configured\n' "$1"
  return 1
}

prompt() {
  local label="$1" secret="$2" value
  if [[ -t 0 ]]; then
    printf '%s: ' "$label" >&2
    if [[ "$secret" == true ]]; then IFS= read -r -s value; else IFS= read -r value; fi || return 1
    if [[ "$secret" == true ]]; then printf '\n' >&2; fi
  else
    printf '%s: ' "$label" > /dev/tty
    if [[ "$secret" == true ]]; then IFS= read -r -s value < /dev/tty; else IFS= read -r value < /dev/tty; fi || return 1
    if [[ "$secret" == true ]]; then printf '\n' > /dev/tty; fi
  fi
  printf '%s' "$value"
}

trim() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  printf '%s' "${value%"${value##*[![:space:]]}"}"
}

if [[ "${1:-}" == auth ]]; then
  usage='usage: transcriber-cli auth status [gemini|meta|microsoft] | auth set <gemini|meta|microsoft> | auth remove <gemini|meta|microsoft>'
  action="${2:-}" provider="${3:-}"
  if [[ "$action" == status && $# -le 3 ]]; then
    if [[ -n "$provider" ]]; then
      valid_provider "$provider"
      provider_status "$provider"
      exit
    fi
    for provider in gemini meta microsoft; do provider_status "$provider" || true; done
    exit 0
  fi
  [[ $# -eq 3 && ( "$action" == set || "$action" == remove ) ]] || fail "$usage"
  valid_provider "$provider"
  path="$(credential_file "$provider")"
  if [[ "$action" == remove ]]; then
    check_secret_file "$path"
    rm -f "$path"
    if [[ "$provider" == microsoft ]]; then
      check_secret_file "$(credential_file microsoft-endpoint)"
      rm -f "$(credential_file microsoft-endpoint)"
    fi
    printf 'Removed saved %s credentials.\n' "$provider"
    exit 0
  fi
  [[ -t 0 ]] || { : < /dev/tty; } 2>/dev/null || fail 'auth set needs an interactive terminal'
  trap '[[ -z "$pending_temp" ]] || rm -f "$pending_temp"' EXIT
  trap 'exit 130' INT TERM
  key="$(prompt "$provider API key" true)" || fail 'could not read API key'
  key="$(trim "$key")"
  [[ -n "$key" ]] || fail 'API key cannot be empty'
  if [[ "$provider" == microsoft ]]; then
    endpoint="$(prompt 'Azure Speech HTTPS resource endpoint' false)" || fail 'could not read endpoint'
    endpoint="$(trim "$endpoint")"
    [[ "$endpoint" =~ ^https://[^/?#@]+/?$ ]] || fail 'endpoint must be an HTTPS resource origin'
    save_secret "$(credential_file microsoft-endpoint)" "${endpoint%/}"
  fi
  save_secret "$path" "$key"
  unset key
  printf 'Saved %s credentials to an owner-only local file.\n' "$provider"
  exit 0
fi

# build_engine: build the pinned engine into the data directory, the same way
# install.sh does. Progress goes to stderr so stdout stays the transcript.
build_engine() {
  local temp source="${TRANSCRIBE_ENGINE_SOURCE:-}"
  if ! command -v go >/dev/null 2>&1 || ! command -v git >/dev/null 2>&1; then
    fail "transcription engine is missing: $engine (install Go and git so it can be built, or run the installer)"
  fi
  temp="$(mktemp -d)"
  printf 'transcriber-cli: building the transcription engine %s (first run only)...\n' "$engine_ref" >&2
  if [[ -z "$source" ]]; then
    git -c advice.detachedHead=false clone --quiet --depth 1 --branch "$engine_ref" "$engine_url" "$temp/src" >&2 ||
      { rm -rf "$temp"; fail 'could not download the transcription engine source'; }
    source="$temp/src"
    [[ "$(git -C "$source" rev-parse HEAD)" == "$engine_sha" ]] ||
      { rm -rf "$temp"; fail 'release tag does not match the pinned source commit'; }
  fi
  (cd "$source" && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X main.version=$engine_ref" -o "$temp/engine" ./cmd/cli) >&2 ||
    { rm -rf "$temp"; fail 'could not build the transcription engine'; }
  mkdir -p "$data_dir"
  # Install under a unique name, then rename, so a concurrent run never sees a partial file.
  install -m 755 "$temp/engine" "$engine.$$"
  mv -f "$engine.$$" "$engine"
  rm -rf "$temp"
}

# mcp_stamp <source dir>: a checksum of the MCP server source, so a plugin
# update rebuilds the server.
mcp_stamp() { cat "$1/go.mod" "$1/go.sum" "$1"/*.go "$1/viewer.html" | cksum; }

# build_mcp <source dir> <server path>: build the MCP server from the source
# shipped beside this script in the Claude Code plugin or a checkout.
build_mcp() {
  local temp version
  command -v go >/dev/null 2>&1 || fail "MCP server is missing: $2 (install Go so it can be built, or run the installer)"
  version="$(sed -n 's/^ *"version": *"\([^"]*\)".*/\1/p' "$1/../.claude-plugin/plugin.json" 2>/dev/null | head -n 1)"
  temp="$(mktemp -d)"
  printf 'transcriber-cli: building the MCP server (first run only)...\n' >&2
  (cd "$1" && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X main.version=${version:-dev}" -o "$temp/server" .) >&2 ||
    { rm -rf "$temp"; fail 'could not build the MCP server'; }
  mkdir -p "$(dirname "$2")"
  install -m 755 "$temp/server" "$2.$$"
  mv -f "$2.$$" "$2"
  mcp_stamp "$1" > "$2.source"
  rm -rf "$temp"
}

# transcriber-cli mcp: run the stdio MCP server. It calls this wrapper for each
# transcription, so credentials and model checks stay in one place.
if [[ "${1:-}" == mcp ]]; then
  [[ $# -eq 1 ]] || fail 'usage: transcriber-cli mcp'
  self="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
  server="${TRANSCRIBER_MCP_BIN:-$data_dir/transcriber-mcp}"
  mcp_source="$(dirname "$self")/../mcp-server"
  if [[ -z "${TRANSCRIBER_MCP_BIN:-}" && -f "$mcp_source/go.mod" ]] &&
     { [[ ! -x "$server" ]] || [[ "$(cat "$server.source" 2>/dev/null)" != "$(mcp_stamp "$mcp_source")" ]]; }; then
    build_mcp "$mcp_source" "$server"
  fi
  [[ -x "$server" ]] || fail "MCP server is missing: $server (run the installer again)"
  TRANSCRIBER_CLI="$self" exec "$server"
fi

if [[ ! -x "$engine" ]]; then
  [[ -z "${TRANSCRIBER_ENGINE_BIN:-}" ]] || fail "transcription engine is missing: $engine"
  build_engine
fi

# Only the three direct speech models are supported. The model also picks the
# provider: only that provider's credentials reach the engine (and the ffmpeg
# processes it starts), whether they come from saved files or the environment.
#
# Find -model the way the engine's Go flag package does: stop at "--" or the
# first non-flag argument, and skip the value of every flag that takes one.
# Keep bool_flags in sync with the engine's boolean flags.
bool_flags=' h help version judge agentic auto-format remove-fillers skill-router '
model='gemini-3.5-transcribe'
args=("$@")
for ((i = 0; i < ${#args[@]}; i++)); do
  arg="${args[i]}"
  [[ "$arg" == -?* && "$arg" != -- ]] || break
  name="${arg#-}"
  name="${name#-}"
  if [[ "$name" == *=* ]]; then
    [[ "${name%%=*}" != model ]] || model="${name#*=}"
    continue
  fi
  [[ "$bool_flags" != *" $name "* ]] || continue
  if [[ "$name" == model && $((i + 1)) -lt ${#args[@]} ]]; then model="${args[i + 1]}"; fi
  i=$((i + 1))
done
case "$model" in
  gemini-3.5-transcribe) providers=(gemini) ;;
  muse-voice-transcribe-1.0) providers=(meta) ;;
  MAI-Transcribe-2) providers=(microsoft microsoft-endpoint) ;;
  *) fail "unsupported model: $model (use gemini-3.5-transcribe, muse-voice-transcribe-1.0, or MAI-Transcribe-2)" ;;
esac

for item in gemini meta microsoft microsoft-endpoint; do
  variable="$(env_name "$item")"
  case " ${providers[*]} " in
    *" $item "*)
      if [[ -z "${!variable:-}" ]]; then
        value="$(read_secret "$(credential_file "$item")")"
        if [[ -n "$value" ]]; then export "$variable=$value"; fi
      fi
      ;;
    *) unset "$variable" ;;
  esac
done
unset value
exec "$engine" "$@"
